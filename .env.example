# Copiez ce fichier en « .env » puis complétez.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Obligatoire en production : 32 caractères aléatoires minimum (openssl rand -hex 32)
SESSION_SECRET=

# Stripe (laisser vide = mode démo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails via Resend (laisser vide = e-mails affichés dans la console)
RESEND_API_KEY=
EMAIL_FROM=Maison Green <commandes@maisongreen.fr>

# Mot de passe du compte admin créé au premier lancement
ADMIN_PASSWORD=
